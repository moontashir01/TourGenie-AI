# MongoDB Atlas connection string (see README for how to get this)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tourgenie?retryWrites=true&w=majority

# Any long random string works — used to sign JWTs
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Where your frontend runs (Vite default)
CLIENT_URL=http://localhost:5173

PORT=5000
NODE_ENV=development

# Fill these in when you wire up the AI / weather / hotel / maps / storage
# integrations described in the proposal's SRS (section 2.5)
# AI itinerary generation (FR-04). Providers are tried in order:
# Groq -> Claude -> OpenAI; any without a key is skipped.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Groq free tier meters prompt + completion tokens per minute (8000 by default).
# Raise GROQ_TPM_LIMIT if you upgrade the plan; the two caps below shrink the
# prompt for country-wide trips so it fits inside that budget.
GROQ_TPM_LIMIT=8000
MAX_OPTIONAL_ATTRACTIONS=25
MAX_CANDIDATE_CITIES=12

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENWEATHER_API_KEY=
# FR-05 — real flight fares. Providers are tried in order; the first one
# with a key that returns results wins. With neither set, the app falls back
# to the seeded demo schedules and labels them as not-real in the UI.
#
# Travelpayouts (Aviasales) Data API — free token, no card, no per-call
# billing. Sign up at https://www.travelpayouts.com and copy the API token
# from your profile. Prices are real fares found by Aviasales users in the
# last 48 hours, not live availability.
TRAVELPAYOUTS_API_KEY=
# Optional affiliate marker appended to booking links.
TRAVELPAYOUTS_MARKER=

# Ignav — 1,000 free requests, no card. https://ignav.com
IGNAV_API_KEY=
OPENROUTESERVICE_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
